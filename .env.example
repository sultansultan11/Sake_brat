# ===== Majburiy =====

# @BotFather bergan token (masalan: 123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx)
BOT_TOKEN=

# Yangi murojaatlar yuboriladigan chat ID'si:
#  - shaxsiy chat bo'lsa — admin foydalanuvchi ID'si (masalan: 123456789);
#  - guruh bo'lsa — guruh ID'si (masalan: -1001234567890).
# /admin buyrug'i va murojaatlarga javob berish faqat shu chatda ishlaydi.
ADMIN_CHAT_ID=

# ===== Ixtiyoriy =====

# Sana va murojaat raqamidagi yil uchun vaqt zonasi
# TIMEZONE=Asia/Tashkent

# Murojaat raqamlari hisoblagichi fayli (faqat {"year": 2026, "last": 17}).
# Qatorni umuman yozmasangiz — appeal_counter.json ishlatiladi.
# Bo'sh qoldirsangiz (COUNTER_FILE=) — faylga hech narsa yozilmaydi, lekin
# bot qayta ishga tushganda raqamlash yana 001 dan boshlanadi.
# COUNTER_FILE=appeal_counter.json

# /admin ro'yxati uchun xotirada ushlanadigan murojaatlar soni
# MAX_APPEALS_IN_MEMORY=500

# Murojaat necha soniya to'ldirilmasa, avtomatik bekor qilinadi (min 60)
# CONVERSATION_TIMEOUT=1800

# Bir foydalanuvchi 24 soat ichida yuborishi mumkin bo'lgan murojaatlar soni
# MAX_APPEALS_PER_DAY=3
